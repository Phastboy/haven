{
  "name": "haven",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "elysia": "next",
    "@elysia/eden": "next",
    "@elysia/static": "next",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web ng serve",
    "dev": "bun run dev:api & bun run dev:web",
    "build:web": "cd apps/web && ng build",
    "start:web": "bun apps/web/dist/web/server/server.mjs",
    "test:api": "bun run --cwd apps/api test",
    "lint:api": "bun run --cwd apps/api lint"
  }
}
