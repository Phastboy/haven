{
  "name": "haven",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt src/ apps/",
    "dev": "bun run --parallel --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "build:web": "bun run --cwd apps/web build",
    "start:web": "bun apps/web/dist/server/entry.mjs",
    "test:api": "bun run --cwd apps/api test"
  },
  "dependencies": {
    "elysia": "2.0.0-beta.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "bunx oxlint"
    ]
  }
}
