{
  "name": "haven",
  "version": "1.0.50",
  "type": "module",
  "module": "src/index.js",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns '**/*.e2e.test.ts' '**/*.integration.test.ts'",
    "test:integration": "bun test integration.test.ts",
    "test:e2e": "bun test e2e.test.ts",
    "dev": "bun run --watch src/index.ts",
    "check:tsc": "tsc --noEmit",
    "db:setup": "bun run src/database/setup.ts"
  },
  "dependencies": {
    "@elysia/openapi": "next",
    "dotenv": "^17.4.2",
    "elysia": "next",
    "google-auth-library": "^11.0.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
