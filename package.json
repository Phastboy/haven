{
  "name": "haven",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "elysia": "next",
    "@elysia/eden": "next",
    "@elysia/static": "next",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0"
  },
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt src/ apps/",
    "dev": "bun run --parallel --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "build:web": "cd apps/web && ng build",
    "start:web": "bun apps/web/dist/web/server/server.mjs",
    "test:api": "bun run --cwd apps/api test",
    "lint:api": "bun run --cwd apps/api lint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "bunx oxlint"
    ]
  }
}
