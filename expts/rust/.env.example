# ==============================================================================
# Haven Rust Application Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database Connection String (Required)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>[?options]
# Local development default:
DATABASE_URL=postgres://user:password@127.0.0.1:5433/haven_rust
# Production (e.g. Koyeb hosted PostgreSQL):
# DATABASE_URL=postgres://koyeb-adm:<password>@<host>.koyeb.app:5432/koyebdb?sslmode=require

# Database Connection Pool Size (Optional, default: 20)
# Must be an integer greater than 0.
DB_POOL_SIZE=20

# Server Network Binding (Optional, defaults: HOST=127.0.0.1, PORT=3000)
# In Docker / cloud deployment, HOST must be 0.0.0.0 and PORT is set by container/platform.
HOST=127.0.0.1
PORT=3000

# Application Environment (Optional, defaults to production-safe if unset)
# Set to 'development' or 'dev' for local testing to relax origin checks on LAN and use local mail delivery.
APP_ENV=development


# Public Base URL (Optional, default: http://localhost:8080)
# Used for constructing magic sign-in links and external redirects.
# In production: https://<your-app>.koyeb.app
PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Optional in local dev, Required for Google Sign-In)
# Obtain these from Google Cloud Console (APIs & Services > Credentials).
# Authorized redirect URI defaults to: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: specify custom callback endpoint path (default: /auth/google/callback)
# GOOGLE_CALLBACK_ENDPOINT=/auth/google/callback
# Optional: full redirect URI override (if not using PUBLIC_BASE_URL + GOOGLE_CALLBACK_ENDPOINT)
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
