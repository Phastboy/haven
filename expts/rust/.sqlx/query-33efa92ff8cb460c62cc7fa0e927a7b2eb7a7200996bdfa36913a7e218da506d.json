  "query": "\n        SELECT u.id, u.account_id, u.created_at, u.updated_at\n        FROM session s\n        JOIN \"user\" u ON u.account_id = s.account_id\n        WHERE s.token_hash = $1 AND s.expires_at > now()\n        ",
