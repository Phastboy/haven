  "query": "\n                SELECT id, conversation_id, sender_id, body, offer_id, created_at\n                FROM message\n                WHERE conversation_id = $1\n                  AND (created_at > $2 OR (created_at = $2 AND id > $3))\n                ORDER BY created_at ASC, id ASC\n                LIMIT $4\n                ",
