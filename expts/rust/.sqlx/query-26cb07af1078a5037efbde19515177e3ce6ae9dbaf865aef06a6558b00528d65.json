{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id, u.account_id, u.handle, u.display_name, u.bio, u.created_at, u.updated_at\n            FROM session s\n            JOIN \"user\" u ON s.account_id = u.account_id\n            WHERE s.token_hash = $1 AND s.expires_at > now()\n            ",
