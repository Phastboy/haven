{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            m.sender_id,\n            m.conversation_id,\n            MAX(m.created_at) AS \"last_inquiry_at!\",\n            COUNT(m.id) AS message_count\n        FROM message m\n        WHERE m.offer_id = $1\n        GROUP BY m.sender_id, m.conversation_id\n        ORDER BY MAX(m.created_at) DESC\n        LIMIT $2\n        ",
