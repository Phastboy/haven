  "query": "\n            SELECT o.id, o.user_id, o.slug, o.title, o.description, o.price, o.currency, o.created_at, o.updated_at,\n                   u.display_name, u.handle\n            FROM offer o\n            JOIN \"user\" u ON o.user_id = u.id\n            ORDER BY o.created_at DESC, o.id DESC\n            LIMIT $1\n            ",
