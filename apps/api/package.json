{
  "name": "@haven/api",
  "version": "1.0.50",
  "type": "module",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "bun run db:push && bun test",
    "test:unit": "bun test --path-ignore-patterns '**/*.e2e.test.ts' '**/*.integration.test.ts'",
    "test:integration": "bun run db:push --force && bun test '**/*.integration.test.ts'",
    "test:e2e": "bun run db:push --force && bun test e2e.test.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysia/cron": "2.0.0-beta.1",
    "@elysia/graphql-yoga": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.4",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.83.0",
    "tslib": "^2.8.1"
  }
}
