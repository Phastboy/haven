# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5433/mydb"

# Auth Module
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_BASE_URL=http://localhost:4200
EMAIL_FROM=noreply@haven.app
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=your-id
GOOGLE_CLIENT_SECRET=
TOKEN_SECRET=
PRIME_UI_LICENSE=
ENABLE_CONSOLE_EMAIL=true

# Config endpoint key-pair authentication (Ed25519)
# Generate a key pair with:
#   node -e "const { generateKeyPairSync } = require('crypto');
#     const { privateKey, publicKey } = generateKeyPairSync('ed25519', {
#       publicKeyEncoding:  { type: 'spki',  format: 'pem' },
#       privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
#     });
#     console.log('PUBLIC:\n', publicKey);
#     console.log('PRIVATE:\n', privateKey);"
# Store the PUBLIC key here (API side — never the private key).
# Store the PRIVATE key in apps/web/.env as CONFIG_PRIVATE_KEY.
CONFIG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
