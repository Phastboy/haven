# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:4200

# Database
DATABASE_URL=postgres://user:password@localhost:5432/haven_db

# Security
TOKEN_SECRET=your_super_secret_key_min_16_chars
SESSION_TTL_DAYS=30

# Magic Links
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_BASE_URL=http://localhost:4200

# External Auth (Optional)
GOOGLE_CLIENT_ID=

# Email Settings
ENABLE_CONSOLE_EMAIL=true
EMAIL_FROM=noreply@haven.app

# SMTP Settings (Optional if ENABLE_CONSOLE_EMAIL=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
