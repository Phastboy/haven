---
interface Props {
  offer: any;
}

const { offer } = Astro.props;
---

<a href={`/offers/${offer.id}`} class="group flex flex-col cursor-pointer w-full">
  <div class="w-full aspect-square bg-zinc-900 rounded-xl mb-3 overflow-hidden relative">
    {offer.images && offer.images.length > 0 ? (
      <img src={offer.images[0]} alt={offer.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-zinc-800/50 group-hover:bg-zinc-800 transition-colors duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-600"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      </div>
    )}
  </div>
  
  <div class="flex flex-col flex-1 px-0.5">
    <div class="flex justify-between items-start">
      <h3 class="text-[15px] font-medium text-white truncate pr-4">{offer.user?.name || offer.user?.username || "Anonymous"}</h3>
      <span class="text-[13px] text-zinc-400 uppercase tracking-wide">{offer.offerType}</span>
    </div>
    
    <p class="text-[15px] text-zinc-400 truncate leading-snug mt-0.5">{offer.title}</p>
    
    <div class="mt-2 flex items-center">
      <span class="text-[15px] font-semibold text-white">${(offer.price / 100).toFixed(2)}</span>
    </div>
  </div>
</a>
