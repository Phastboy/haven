---
import { formatPrice } from "../lib/format";

export interface OfferCardOffer {
  id: string;
  title: string;
  price: number;
  offerType?: string | null;
  images?: string[] | null;
  user?: { name?: string | null; username?: string | null; profilePictureUrl?: string | null } | null;
}

interface Props {
  offer: OfferCardOffer;
  /** Above-the-fold cards load eagerly; the rest lazily. */
  priority?: boolean;
}

const { offer, priority = false } = Astro.props;
const author = offer.user?.name || offer.user?.username || "Anonymous";
const isRequest = (offer.offerType ?? "").toUpperCase() === "REQUEST";
---

<a
  href={`/offers/${offer.id}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900/40 transition-colors active:border-zinc-700 sm:hover:border-zinc-700"
>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-zinc-900">
    {offer.images?.[0] ? (
      <img
        src={offer.images[0]}
        alt=""
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 sm:group-hover:scale-105"
      />
    ) : (
      <div class="grid h-full w-full place-items-center bg-zinc-800/40 text-zinc-700">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
        </svg>
      </div>
    )}
    <span
      class:list={[
        "absolute left-2 top-2 rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide backdrop-blur",
        isRequest ? "bg-amber-500/20 text-amber-300" : "bg-brand-500/20 text-brand-200",
      ]}
    >
      {isRequest ? "Request" : "Offer"}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-1 p-3">
    <!-- Title first: it is what people scan for. -->
    <h3 class="line-clamp-2 text-sm font-medium leading-snug text-white">{offer.title}</h3>
    <p class="truncate text-xs text-zinc-500">{author}</p>
    <p class="mt-auto pt-1 text-sm font-semibold text-white">{formatPrice(offer.price)}</p>
  </div>
</a>
