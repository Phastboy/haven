---
import "../styles/global.css";
import { client } from "../api";

const token = Astro.cookies.get("token")?.value;

let user = null;
if (token) {
  const { data, error } = await client.auth.me.get({
    headers: {
      authorization: `Bearer ${token}`
    }
  });
  if (data?.account) {
    user = data.account;
  }
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Haven</title>
	</head>
	<body class="min-h-screen flex flex-col">
		<nav class="border-b border-white/5 bg-zinc-950/80 backdrop-blur-xl sticky top-0 z-50">
			<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="font-bold text-xl tracking-tight flex items-center gap-2 group">
					<div class="w-6 h-6 rounded-lg bg-brand-500 opacity-90 group-hover:opacity-100 transition-opacity"></div>
					<span>Haven</span>
				</a>
				<div class="flex items-center gap-6 text-sm font-medium">
					<a href="/directory" class="text-zinc-400 hover:text-white transition-colors">
						Directory
					</a>
					{user ? (
						<>
							<div class="relative group py-2">
								<button class="text-zinc-400 group-hover:text-white transition-colors flex items-center gap-1 outline-none">
									Dashboard
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100"><path d="m6 9 6 6 6-6"/></svg>
								</button>
								<div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-40 bg-zinc-900 border border-zinc-800 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 overflow-hidden">
									<div class="py-1">
										<a href="/my-offers" class="block px-4 py-2 text-sm text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors">My Offers</a>
										<a href="/matches" class="block px-4 py-2 text-sm text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors">Matches</a>
									</div>
								</div>
							</div>
							<a href="/profile" class="text-zinc-400 hover:text-white transition-colors">
								Profile
							</a>
						</>
					) : (
						<a href="/login" class="px-4 py-2 rounded-xl bg-white text-zinc-950 hover:bg-zinc-200 transition-colors">
							Login
						</a>
					)}
				</div>
			</div>
		</nav>
		<main class="flex-1 flex flex-col">
			<slot />
		</main>
	</body>
</html>
