---
import "../styles/global.css";
import { getSession } from "../lib/session";
import { initials } from "../lib/format";
import { Toaster } from "solid-toaster";
import { NotificationProvider } from "../components/NotificationProvider";

interface Props {
  title?: string;
  description?: string;
  /** Hide the mobile bottom tab bar (e.g. on full-screen forms). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const session = await getSession(Astro);
const user = session?.user ?? null;
const account = session?.account ?? null;

const pageTitle = title ? `${title} · Haven` : "Haven — the community for skills & services";
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const tabs = [
  { href: "/directory", label: "Directory", icon: "M11 3a8 8 0 1 0 4.9 14.32L21 22l1-1-4.68-5.1A8 8 0 0 0 11 3Z" },
  { href: "/matches", label: "Matches", icon: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" },
  { href: "/messages", label: "Messages", icon: "M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6" },
  { href: "/my-offers", label: "My offers", icon: "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" },
  { href: "/profile", label: "Profile", icon: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" },
];
const showTabs = !bare && !!account;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-950 text-zinc-50">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-zinc-950">
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-white/5 bg-zinc-950/85 backdrop-blur-xl pt-[env(safe-area-inset-top)]">
      <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between gap-3 px-4 sm:h-16 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
          <span class="h-6 w-6 rounded-lg bg-brand-500"></span>
          Haven
        </a>
        <nav class="hidden items-center gap-1 text-sm font-medium sm:flex">
          {account
            ? tabs.map((tab) => (
                <a
                  href={tab.href}
                  aria-current={isActive(tab.href) ? "page" : undefined}
                  class:list={[
                    "rounded-lg px-3 py-2 transition-colors",
                    isActive(tab.href) ? "bg-white/10 text-white" : "text-zinc-400 hover:text-white",
                  ]}
                >
                  {tab.label}
                </a>
              ))
            : (
              <a href="/directory" class="rounded-lg px-3 py-2 text-zinc-400 transition-colors hover:text-white">
                Directory
              </a>
            )}
        </nav>

        {account ? (
          <a
            href="/profile"
            aria-label="Your profile"
            class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-zinc-700 bg-zinc-800 text-sm font-semibold sm:hidden"
          >
            {user?.profilePictureUrl ? (
              <img src={user.profilePictureUrl} alt="" class="h-full w-full rounded-full object-cover" />
            ) : (
              initials(user?.name, user?.username ?? account.email)
            )}
          </a>
        ) : (
          <a
            href="/login"
            class="rounded-xl bg-white px-4 py-2 text-sm font-medium text-zinc-950 transition-colors hover:bg-zinc-200"
          >
            Log in
          </a>
        )}
      </div>
    </header>

    <main id="main" class:list={["flex flex-1 flex-col", showTabs && "pb-[calc(4rem+env(safe-area-inset-bottom))] sm:pb-0"]}>
      <slot />
    </main>

    {showTabs && (
      <nav
        aria-label="Primary"
        class="fixed inset-x-0 bottom-0 z-40 border-t border-white/5 bg-zinc-950/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl sm:hidden"
      >
        <ul class="mx-auto flex max-w-lg">
          {tabs.map((tab) => (
            <li class="flex-1">
              <a
                href={tab.href}
                aria-current={isActive(tab.href) ? "page" : undefined}
                class:list={[
                  "flex min-h-14 flex-col items-center justify-center gap-1 px-1 py-2 text-[11px] font-medium transition-colors",
                  isActive(tab.href) ? "text-brand-400" : "text-zinc-500 active:text-zinc-300",
                ]}
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={tab.icon} />
                </svg>
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <Toaster client:load position="bottom-right" />
    {session?.token && <NotificationProvider client:only="solid" token={session.token} />}
  </body>
</html>
