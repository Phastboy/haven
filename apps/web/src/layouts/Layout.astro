---
import "../styles/global.css";
import { getSession } from "../lib/session";
import { Toaster } from "solid-toaster";
import { NotificationProvider } from "../components/NotificationProvider";
import TopBar from "../features/nav/TopBar.astro";
import BottomTabs from "../features/nav/BottomTabs.astro";
import { toNavUser } from "../features/nav/nav-user";

interface Props {
  title?: string;
  description?: string;
  /** Hide the mobile bottom tab bar (e.g. on full-screen forms). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const session = await getSession(Astro);
const user = toNavUser(session);

const pageTitle = title ? `${title} · Haven` : "Haven — the community for skills & services";
const path = Astro.url.pathname;
const showTabs = !bare && !!user;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-950 text-zinc-50">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-zinc-950">
      Skip to content
    </a>

    <TopBar path={path} user={user} />

    <!-- Members have no top bar on phones, so the page itself must clear the status bar. -->
    <main
      id="main"
      class:list={[
        "flex flex-1 flex-col",
        user && "pt-[env(safe-area-inset-top)] sm:pt-0",
        showTabs && "pb-[calc(4rem+env(safe-area-inset-bottom))] sm:pb-0",
      ]}
    >
      <slot />
    </main>

    {!bare && user && <BottomTabs path={path} user={user} />}

    <Toaster client:load position="bottom-right" />
    {session?.token && <NotificationProvider client:only="solid" token={session.token} />}
  </body>
</html>
