---
import Avatar from "./Avatar.astro";
import type { NavUser } from "./types";

interface Props {
  user: NavUser;
}
const { user } = Astro.props;
const row =
  "block w-full px-4 py-2.5 text-left text-sm transition-colors hover:bg-white/5 focus-visible:bg-white/5 focus-visible:outline-none";
---

<details data-account-menu class="relative hidden sm:block">
  <summary
    aria-label="Account menu"
    class="cursor-pointer list-none rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/60 [&::-webkit-details-marker]:hidden"
  >
    <Avatar user={user} class="h-9 w-9 border border-zinc-700 text-sm" />
  </summary>

  <div class="absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 shadow-lg shadow-black/40">
    <div class="border-b border-zinc-800 px-4 py-3">
      <p class="truncate text-sm font-medium">{user.name || user.username || user.email}</p>
      <p class="truncate text-xs text-zinc-500">{user.email}</p>
    </div>
    <a href="/profile" class={`${row} text-zinc-200`}>Profile</a>
    <a href="/settings" class={`${row} text-zinc-200`}>Settings</a>
    <form method="post" action="/logout" class="border-t border-zinc-800">
      <button type="submit" class={`${row} text-red-500`}>Log out</button>
    </form>
  </div>
</details>

<script>
  // <details> has no outside-click or Escape handling of its own.
  document.querySelectorAll<HTMLDetailsElement>("[data-account-menu]").forEach((menu) => {
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  });
</script>
