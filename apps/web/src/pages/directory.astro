---
import Layout from "../layouts/Layout.astro";
import OfferCard, { type OfferCardOffer } from "../components/OfferCard.astro";
import { GRAPHQL_URL } from "../api";

type DirectoryOffer = OfferCardOffer & { description: string; createdAt: string };

const query = `
  query {
    activeOffers(limit: 50, offset: 0) {
      id title description price offerType createdAt images
      user { id username name profilePictureUrl }
    }
  }
`;

const search = (Astro.url.searchParams.get("q") ?? "").trim();
const type = Astro.url.searchParams.get("type") ?? "all";

let offers: DirectoryOffer[] = [];
let error: string | null = null;

try {
  const res = await fetch(GRAPHQL_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query }),
  });
  if (!res.ok) throw new Error(`Directory unavailable (${res.status})`);
  const body = (await res.json()) as { data?: { activeOffers: DirectoryOffer[] }; errors?: { message: string }[] };
  if (body.errors?.length) throw new Error(body.errors[0].message);
  offers = body.data?.activeOffers ?? [];
} catch (e) {
  error = e instanceof Error ? e.message : "Something went wrong";
}

const needle = search.toLowerCase();
const visible = offers.filter((offer) => {
  const matchesType = type === "all" || (offer.offerType ?? "").toUpperCase() === type.toUpperCase();
  const matchesText =
    !needle ||
    offer.title.toLowerCase().includes(needle) ||
    (offer.description ?? "").toLowerCase().includes(needle);
  return matchesType && matchesText;
});

const filters = [
  { value: "all", label: "All" },
  { value: "OFFER", label: "Offers" },
  { value: "REQUEST", label: "Requests" },
];
const filterHref = (value: string) => {
  const params = new URLSearchParams();
  if (search) params.set("q", search);
  if (value !== "all") params.set("type", value);
  const qs = params.toString();
  return qs ? `/directory?${qs}` : "/directory";
};
---

<Layout title="Directory" description="Browse skills and services offered by the Haven community.">
  <div class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-10">
    <header class="mb-5">
      <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">Directory</h1>
      <p class="mt-1 text-sm text-zinc-400 sm:text-base">Skills and services from the community.</p>
    </header>
    <form method="get" action="/directory" class="mb-4 flex gap-2" role="search">
      <input
        type="search"
        name="q"
        value={search}
        placeholder="Search offers"
        aria-label="Search offers"
        class="min-h-11 w-full rounded-xl border border-zinc-800 bg-zinc-900 px-4 text-base text-white placeholder:text-zinc-600 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
      />
      {type !== "all" && <input type="hidden" name="type" value={type} />}
      <button type="submit" class="min-h-11 shrink-0 rounded-xl bg-white px-4 text-sm font-medium text-zinc-950">
        Search
      </button>
    </form>

    <div class="-mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0">
      {filters.map((f) => (
        <a
          href={filterHref(f.value)}
          class:list={[
            "min-h-9 shrink-0 rounded-full border px-4 py-1.5 text-sm transition-colors",
            type === f.value
              ? "border-white bg-white text-zinc-950"
              : "border-zinc-800 text-zinc-400 active:border-zinc-600",
          ]}
        >
          {f.label}
        </a>
      ))}
    </div>

    {error && (
      <p class="mb-6 rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm text-red-400">
        Failed to load the directory: {error}
      </p>
    )}

    {visible.length === 0 && !error ? (
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-8 text-center">
        <h2 class="text-lg font-medium">{search || type !== "all" ? "No matches" : "Nothing here yet"}</h2>
        <p class="mt-1 text-sm text-zinc-400">
          {search || type !== "all" ? "Try a different search or filter." : "Be the first to post an offer."}
        </p>
        {(search || type !== "all") && (
          <a href="/directory" class="mt-4 inline-block min-h-11 rounded-xl bg-white px-5 py-3 text-sm font-medium text-zinc-950">
            Clear filters
          </a>
        )}
      </div>
    ) : (
      <>
        <p class="mb-3 text-xs text-zinc-500">{visible.length} {visible.length === 1 ? "result" : "results"}</p>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] sm:gap-5">
          {visible.map((offer, i) => (
            <li><OfferCard offer={offer} priority={i < 4} /></li>
          ))}
        </ul>
      </>
    )}
  </div>
</Layout>
