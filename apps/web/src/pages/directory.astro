---
import Layout from "../layouts/Layout.astro";
import OfferCard from "../components/OfferCard.astro";
import { GRAPHQL_URL } from "../api";

const query = `
  query {
    activeOffers(limit: 50, offset: 0) {
      id
      title
      description
      price
      offerType
      createdAt
      images
      user {
        id
        username
        name
        profilePictureUrl
      }
    }
  }
`;

let offers = [];
let error = null;

try {
  const res = await fetch(GRAPHQL_URL, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ query }),
  });
  
  if (!res.ok) {
    throw new Error(`GraphQL Error: ${res.status}`);
  }

  const { data, errors } = await res.json();
  if (errors) {
    throw new Error(errors[0].message);
  }
  
  offers = data?.activeOffers || [];
} catch (e: any) {
  error = e.message;
}
---

<Layout>
  <div class="flex-1 flex flex-col p-6 max-w-7xl mx-auto w-full">
    <div class="mb-10 mt-8">
      <h1 class="text-4xl font-bold text-white tracking-tight">Community Directory</h1>
      <p class="text-zinc-400 mt-2 text-lg">Browse active skills and services offered by the community.</p>
    </div>

    {error && (
      <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 mb-8">
        Failed to load directory: {error}
      </div>
    )}

    {offers.length === 0 && !error ? (
      <div class="flex flex-col items-center justify-center p-12 bg-zinc-900/50 rounded-2xl text-center">
        <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-4 text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
        </div>
        <h3 class="text-xl font-medium text-white mb-2">No active offers yet</h3>
        <p class="text-zinc-400">Be the first to create an offer in the community!</p>
      </div>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-6 gap-y-10">
        {offers.map((offer: any) => (
          <OfferCard offer={offer} />
        ))}
      </div>
    )}
  </div>
</Layout>
