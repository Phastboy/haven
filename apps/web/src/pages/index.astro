---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="flex-1 flex flex-col items-center justify-center p-6 text-center h-full">
    <div class="max-w-3xl space-y-8 py-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-brand-500/10 text-brand-500 text-sm font-medium border border-brand-500/20 mb-4">
        Welcome to Haven
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight leading-tight">
        The community for <span class="text-brand-400">skills & services</span>
      </h1>
      
      <p class="text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Join the directory to offer what you know and request what you need. Connect with others securely and easily.
      </p>
      
      <div class="pt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/login" class="px-8 py-4 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-medium transition-colors text-lg">
          Get Started
        </a>
      </div>
    </div>
  </div>
</Layout>
