---
import Layout from "../layouts/Layout.astro";
import MatchCard from "../components/MatchCard";
import { client } from "../api";

const token = Astro.cookies.get("token")?.value;

if (!token) {
  return Astro.redirect("/login");
}

const { data: authData, error: authError } = await client.auth.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

if (authError || !authData?.account) {
  return Astro.redirect("/login");
}

// Fetch both sent and received orders
const [sentRes, receivedRes] = await Promise.all([
  client.orders.me.get({ headers: { authorization: `Bearer ${token}` } }),
  client.orders.received.get({ headers: { authorization: `Bearer ${token}` } })
]);

const sentOrders = sentRes.data || [];
const receivedOrders = receivedRes.data || [];

// Sort by newest first
sentOrders.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
receivedOrders.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const tab = Astro.url.searchParams.get("tab") || "received";
---

<Layout>
  <div class="flex-1 flex flex-col p-6 max-w-7xl mx-auto w-full">
    <div class="mb-8 mt-8">
      <h1 class="text-4xl font-bold text-white tracking-tight">Matches</h1>
      <p class="text-zinc-400 mt-2 text-lg">Manage your sent and received requests.</p>
    </div>

    {/* Tabs */}
    <div class="flex border-b border-zinc-800 mb-8 overflow-x-auto">
      <a 
        href="?tab=received" 
        class={`px-6 py-4 font-medium whitespace-nowrap transition-colors border-b-2 ${
          tab === "received" 
            ? "border-brand-500 text-brand-500" 
            : "border-transparent text-zinc-400 hover:text-white"
        }`}
      >
        Received Requests
        {receivedOrders.filter((o: any) => o.status === "PENDING").length > 0 && (
          <span class="ml-2 inline-flex items-center justify-center w-5 h-5 text-xs font-bold bg-brand-500 text-white rounded-full">
            {receivedOrders.filter((o: any) => o.status === "PENDING").length}
          </span>
        )}
      </a>
      <a 
        href="?tab=sent" 
        class={`px-6 py-4 font-medium whitespace-nowrap transition-colors border-b-2 ${
          tab === "sent" 
            ? "border-brand-500 text-brand-500" 
            : "border-transparent text-zinc-400 hover:text-white"
        }`}
      >
        Sent Requests
      </a>
    </div>

    {/* Received Tab Content */}
    {tab === "received" && (
      <div>
        {receivedOrders.length === 0 ? (
          <div class="flex flex-col items-center justify-center p-12 bg-zinc-900/50 rounded-2xl text-center border border-zinc-800">
            <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-4 text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 class="text-xl font-medium text-white mb-2">No received requests yet</h3>
            <p class="text-zinc-400 max-w-md">When someone requests one of your offers, it will appear here.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {receivedOrders.map((order: any) => (
              <MatchCard client:load order={order} token={token} isReceived={true} />
            ))}
          </div>
        )}
      </div>
    )}

    {/* Sent Tab Content */}
    {tab === "sent" && (
      <div>
        {sentOrders.length === 0 ? (
          <div class="flex flex-col items-center justify-center p-12 bg-zinc-900/50 rounded-2xl text-center border border-zinc-800">
            <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-4 text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-xl font-medium text-white mb-2">No sent requests</h3>
            <p class="text-zinc-400 mb-6 max-w-md">Browse the directory to find skills or services you need.</p>
            <a href="/directory" class="px-6 py-3 bg-white text-zinc-950 hover:bg-zinc-200 rounded-xl font-medium transition-colors">
              Explore Directory
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {sentOrders.map((order: any) => (
              <MatchCard client:load order={order} token={token} isReceived={false} />
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</Layout>
