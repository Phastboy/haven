---
import Layout from "../layouts/Layout.astro";
import ProfileForm from "../components/ProfileForm";
import { client } from "../api";

const token = Astro.cookies.get("token")?.value;

if (!token) {
  return Astro.redirect("/login");
}

const { data: authData, error: authError } = await client.auth.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

if (authError || !authData?.account) {
  return Astro.redirect("/login");
}

const { data: userData, error: userError } = await client.users.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

const user = userData || { email: authData.account.email };
if (userData && !(userData as any).email) {
  (user as any).email = authData.account.email;
}
---

<Layout>
  <div class="flex-1 flex flex-col p-6">
    <div class="w-full max-w-2xl mx-auto mt-8">
      <h1 class="text-3xl font-bold text-white tracking-tight">Your Profile</h1>
      <p class="text-zinc-400 mt-2">Manage your public information and account settings.</p>
    </div>
    
    <ProfileForm client:load user={user} token={token} />
  </div>
</Layout>
