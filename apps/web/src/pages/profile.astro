---
import Layout from "../layouts/Layout.astro";
import ProfileForm from "../components/ProfileForm";
import { requireSession } from "../lib/session";

const guard = await requireSession(Astro);
if (guard.redirect) return guard.redirect;
const session = guard.session;
const user = { ...(session.user ?? {}), email: (session.user as any)?.email || session.account.email };
---

<Layout title="Profile">
  <div class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6 sm:py-10">
    <header class="mb-5">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Your profile</h1>
      <p class="mt-1 text-sm text-zinc-400">Your public information and account settings.</p>
    </header>
    <ProfileForm client:load user={user} />

    <div class="mt-8 flex justify-center">
      <form method="post" action="/logout">
        <button type="submit" class="text-sm font-medium text-red-500 hover:text-red-400 transition-colors">
          Log out of your account
        </button>
      </form>
    </div>
  </div>
</Layout>
