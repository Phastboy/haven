---
/**
 * /auth/google/callback
 *
 * Receives the Google idToken from the LoginForm (posted as a regular HTML form),
 * exchanges it for a Haven session token, sets the httpOnly cookie, then redirects.
 *
 * Using a form POST instead of fetch keeps the session cookie flow identical to
 * the magic-link path: the cookie is set server-side and never exposed to JS.
 */
import { client } from "../../../api";

if (Astro.request.method !== "POST") {
  return Astro.redirect("/login");
}

// Read returnUrl, but don't delete yet. If verification fails, retries preserve the intended destination.
const returnUrlCookie = Astro.cookies.get("returnUrl")?.value;

const isSafeRedirectTarget = (url: string | undefined | null): boolean => {
  if (!url) return false;
  // eslint-disable-next-line no-control-regex
  if (/[\x00-\x1F\x7F]/.test(url)) return false;
  return url.startsWith("/") && !url.startsWith("//") && !url.includes("\\");
};
const safeRedirect = isSafeRedirectTarget(returnUrlCookie) ? returnUrlCookie! : "/directory";


let idToken: string | null = null;

try {
  const formData = await Astro.request.formData();
  idToken = formData.get("idToken") as string | null;
} catch {
  return Astro.redirect("/login?error=google_failed");
}

if (!idToken) {
  return Astro.redirect("/login?error=google_failed");
}

try {
  const { data: resData, error } = await client.auth.google.login.post({ idToken });
  const data = resData?.data;

  if (error || !data) {
    return Astro.redirect("/login?error=google_failed");
  }

  Astro.cookies.set("token", data.token, {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    maxAge: 30 * 24 * 60 * 60, // 30 days
  });

  // Verification succeeded, safely consume the returnUrl cookie
  Astro.cookies.delete("returnUrl", { path: "/" });
  return Astro.redirect(safeRedirect);
} catch {
  return Astro.redirect("/login?error=google_failed");
}
---
