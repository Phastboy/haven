---
import Layout from "../../layouts/Layout.astro";
import { client } from "../../api";
import ChatRoom from "../../components/ChatRoom";
import type { ChatMessage } from "../../types";

const token = Astro.cookies.get("token")?.value;

if (!token) {
  return Astro.redirect("/login");
}

const { data: authDataRes, error: authError } = await client.auth.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});
const authData = (authDataRes as { data?: { account: { id: string } } })?.data;

if (authError || !authData?.account) {
  return Astro.redirect("/login");
}

const user = authData.account;
const threadId = Astro.params.id as string;

// Fetch all threads to find the details of this specific thread
const { data: threadsRes, error: threadsError } = await client.messages.threads.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});
const threads = (threadsRes as { data?: Array<{ id: string; participant1: { id: string; name?: string | null; profilePictureUrl?: string | null; username?: string | null }; participant2: { id: string; name?: string | null; profilePictureUrl?: string | null; username?: string | null } }> })?.data;

if (threadsError || !threads) {
  return Astro.redirect("/messages");
}

const thread = threads.find((t: { id: string; participant1: { id: string; name?: string | null; profilePictureUrl?: string | null; username?: string | null }; participant2: { id: string; name?: string | null; profilePictureUrl?: string | null; username?: string | null } }) => t.id === threadId);

if (!thread) {
  return Astro.redirect("/messages");
}

const isUser1 = thread.participant1.id === user.id;
const otherUser = isUser1 ? thread.participant2 : thread.participant1;

// Fetch initial messages for SSR
const { data: messagesRes, error: messagesError } = await client.messages.threads({ threadId }).get({
  headers: {
    authorization: `Bearer ${token}`
  }
});
const messages = (messagesRes as { data?: ChatMessage[] })?.data;

const initialMessages = messages || [];
---

<Layout>
  <div class="flex-1 flex flex-col h-[calc(100vh-64px)] max-h-[calc(100vh-64px)] overflow-hidden max-w-5xl mx-auto w-full">
    {/* Header */}
    <div class="h-20 border-b border-zinc-800 flex items-center px-6 shrink-0 bg-zinc-950/50 backdrop-blur-md z-10 sticky top-0">
      <a href="/messages" class="mr-4 p-2 -ml-2 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 overflow-hidden flex-shrink-0">
          {otherUser.profilePictureUrl ? (
            <img
              src={otherUser.profilePictureUrl}
              alt={otherUser.name || otherUser.username}
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-zinc-500 font-medium uppercase">
              {(otherUser.name || otherUser.username || "U")[0]}
            </div>
          )}
        </div>
        <div>
          <h2 class="text-white font-bold">{otherUser.name || otherUser.username}</h2>
          <p class="text-xs text-zinc-400">Match Chat</p>
        </div>
      </div>
    </div>

    {/* Chat Room Client Component */}
    <div class="flex-1 overflow-hidden relative">
      <ChatRoom 
        client:load 
        threadId={threadId} 
        currentUserId={user.id}
        otherUser={otherUser}
        initialMessages={initialMessages}
        token={token} 
      />
    </div>
  </div>
</Layout>
