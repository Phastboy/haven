---
import Layout from "../../layouts/Layout.astro";
import { client } from "../../api";

const token = Astro.cookies.get("token")?.value;

if (!token) {
  return Astro.redirect("/login");
}

const { data: authDataRes, error: authError } = await client.auth.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});
const authData = (authDataRes as any)?.data;

if (authError || !authData?.account) {
  return Astro.redirect("/login");
}

const user = authData.account;

const { data: threadsRes, error: threadsError } = await client.messages.threads.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});
const threads = (threadsRes as any)?.data;

const threadList = threads || [];

// Helper to format date
const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  const now = new Date();
  if (date.toDateString() === now.toDateString()) {
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }
  return date.toLocaleDateString([], { month: 'short', day: 'numeric' });
};
---

<Layout>
  <div class="flex-1 flex flex-col p-6 max-w-5xl mx-auto w-full">
    <div class="mb-8 mt-8 flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold text-white tracking-tight">Messages</h1>
        <p class="text-zinc-400 mt-2 text-lg">Your conversations with matches.</p>
      </div>
    </div>

    {threadList.length === 0 ? (
      <div class="flex flex-col items-center justify-center p-12 bg-zinc-900/50 rounded-2xl text-center border border-zinc-800">
        <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-4 text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
        </div>
        <h3 class="text-xl font-medium text-white mb-2">No messages yet</h3>
        <p class="text-zinc-400 max-w-md">Once an offer request is accepted, a chat thread will automatically appear here.</p>
      </div>
    ) : (
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden divide-y divide-zinc-800/50">
        {threadList.map((thread: any) => {
          // Determine the other participant
          const isUser1 = thread.participant1.id === user.id;
          const otherUser = isUser1 ? thread.participant2 : thread.participant1;
          const latestMessage = thread.latestMessage;

          return (
            <a 
              href={`/messages/${thread.id}`}
              class="flex items-center gap-4 p-5 hover:bg-zinc-800/50 transition-colors group cursor-pointer block"
            >
              <div class="w-12 h-12 rounded-full bg-zinc-800 border border-zinc-700 overflow-hidden flex-shrink-0">
                {otherUser.profilePictureUrl ? (
                  <img
                    src={otherUser.profilePictureUrl}
                    alt={otherUser.name || otherUser.username}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-500 font-medium uppercase text-lg">
                    {(otherUser.name || otherUser.username || "U")[0]}
                  </div>
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between mb-1">
                  <h3 class="text-white font-medium truncate pr-4 group-hover:text-brand-400 transition-colors">
                    {otherUser.name || otherUser.username}
                  </h3>
                  {latestMessage && (
                    <span class="text-xs text-zinc-500 whitespace-nowrap flex-shrink-0">
                      {formatDate(latestMessage.createdAt)}
                    </span>
                  )}
                </div>
                <p class="text-sm text-zinc-400 truncate">
                  {latestMessage ? (
                    <span class={latestMessage.senderId !== user.id && !latestMessage.isRead ? "text-white font-medium" : ""}>
                      {latestMessage.senderId === user.id ? "You: " : ""}
                      {latestMessage.content}
                    </span>
                  ) : (
                    <span class="italic opacity-50">No messages yet...</span>
                  )}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
