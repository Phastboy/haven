---
import Layout from "../../layouts/Layout.astro";
import OfferForm from "../../components/OfferForm";
import { requireSession } from "../../lib/session";

const guard = await requireSession(Astro);
if (guard.redirect) return guard.redirect;
---

<Layout title="New offer" bare={true}>
  <div class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6 sm:py-10">
    <a href="/my-offers" class="mb-4 inline-flex min-h-11 items-center gap-1 text-sm text-zinc-400">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      My offers
    </a>
    <OfferForm client:load />
  </div>
</Layout>
