---
import Layout from "../../../layouts/Layout.astro";
import OfferForm from "../../../components/OfferForm";
import { client } from "../../../api";

const { id } = Astro.params;
const token = Astro.cookies.get("token")?.value;

if (!token || !id) {
  return Astro.redirect("/login");
}

// Fetch current user
const { data: authDataRes } = await client.auth.me.get({
  headers: { authorization: `Bearer ${token}` }
});
const authData = (authDataRes as { data?: { account: { id: string } } })?.data;

if (!authData?.account) {
  return Astro.redirect("/login");
}

const { data: currentUserRes } = await client.users.me.get({
  headers: { authorization: `Bearer ${token}` }
});
const currentUserData = (currentUserRes as { data?: { id?: string } })?.data;

// Fetch offer
const { data: offerRes, error } = await client.offers({ id }).get();
const offer = (offerRes as { data?: { id: string; userId: string; [key: string]: unknown } })?.data;

if (error || !offer) {
  return Astro.redirect("/my-offers");
}

// Verify ownership
if (!currentUserData || currentUserData.id !== offer.userId) {
  return Astro.redirect(`/offers/${offer.id}`);
}
---

<Layout>
  <div class="flex-1 flex flex-col p-6">
    <OfferForm client:load initialData={offer} isEdit={true} />
  </div>
</Layout>
