---
import Layout from "../../layouts/Layout.astro";
import { client } from "../../api";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/directory");
}

// Fetch offer details
const { data: offer, error } = await client.offers({ id }).get();

if (error || !offer) {
  return Astro.redirect("/directory");
}

// Fetch the user who created it to display their info
// If the backend has a populated user object we wouldn't need this, but for now:
let creator = null;
if (offer.userId) {
  const { data: userData } = await client.users({ id: offer.userId }).get();
  creator = userData;
}

// Check if the current user owns this offer (to show Edit button)
const token = Astro.cookies.get("token")?.value;
let isOwner = false;
if (token) {
  const { data: authData } = await client.auth.me.get({
    headers: { authorization: `Bearer ${token}` }
  });
  if (authData?.account) {
    const { data: currentUserData } = await client.users.me.get({
      headers: { authorization: `Bearer ${token}` }
    });
    if (currentUserData && (currentUserData as any).id === offer.userId) {
      isOwner = true;
    }
  }
}

const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric"
  });
};
---

<Layout>
  <div class="flex-1 flex flex-col p-4 md:p-8 max-w-4xl mx-auto w-full">
    {/* Stacked Layout - Big Hero Image */}
    <div class="w-full aspect-video bg-zinc-900 rounded-3xl overflow-hidden relative mb-8 border border-zinc-800">
      {offer.images && offer.images.length > 0 ? (
        <img src={offer.images[0]} alt={offer.title} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-zinc-900">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-800"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        </div>
      )}
      
      <div class="absolute top-4 left-4 px-3 py-1.5 bg-zinc-950/80 backdrop-blur-md rounded-lg text-xs font-bold text-white uppercase tracking-wider border border-white/10">
        {offer.offerType}
      </div>
      
      {isOwner && (
        <a href={`/offers/${offer.id}/edit`} class="absolute top-4 right-4 px-4 py-2 bg-brand-500 hover:bg-brand-600 rounded-xl text-sm font-medium text-white transition-colors shadow-lg">
          Edit Offer
        </a>
      )}
    </div>

    {/* Details Section */}
    <div class="flex flex-col gap-6">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div class="flex-1">
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight mb-4">
            {offer.title}
          </h1>
          
          <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-12 rounded-full bg-zinc-800 overflow-hidden border border-zinc-700">
              {creator?.profilePictureUrl ? (
                <img src={creator.profilePictureUrl} alt={creator.name || creator.username} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-500 font-medium text-lg uppercase">
                  {(creator?.name || creator?.username || "A")[0]}
                </div>
              )}
            </div>
            <div>
              <p class="text-white font-medium">{creator?.name || creator?.username || "Anonymous"}</p>
              <p class="text-zinc-500 text-sm">Listed on {formatDate(offer.createdAt)}</p>
            </div>
          </div>
        </div>

        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 md:min-w-[280px]">
          <div class="text-zinc-400 text-sm font-medium uppercase tracking-wider mb-1">Price</div>
          <div class="text-4xl font-bold text-white mb-6">
            ${(offer.price / 100).toFixed(2)}
          </div>
          
          {!isOwner && (
            <button class="w-full px-6 py-4 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-medium transition-colors text-lg flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              Contact {creator?.name?.split(" ")[0] || "Provider"}
            </button>
          )}
        </div>
      </div>

      <div class="prose prose-invert max-w-none">
        <h2 class="text-xl font-bold text-white mb-4 border-b border-zinc-800 pb-2">About this offer</h2>
        <div class="text-zinc-300 text-lg leading-relaxed whitespace-pre-wrap">
          {offer.description || "No description provided."}
        </div>
      </div>
    </div>
  </div>
</Layout>
