---
import Layout from "../layouts/Layout.astro";
import OfferCard from "../components/OfferCard.astro";
import { client } from "../api";

const token = Astro.cookies.get("token")?.value;

if (!token) {
  return Astro.redirect("/login");
}

const { data: authData, error: authError } = await client.auth.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

if (authError || !authData?.account) {
  return Astro.redirect("/login");
}

// Fetch current user
const { data: userData } = await client.users.me.get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

if (!userData) {
  return Astro.redirect("/profile");
}

const userId = (userData as any).id;

const { data: offersData, error: offersError } = await client.offers.user({ userId }).get({
  headers: {
    authorization: `Bearer ${token}`
  }
});

let offers = [];
if (offersData && Array.isArray(offersData)) {
  // Map it slightly so OfferCard can render it properly
  // OfferCard expects: offer.user.name/username, offer.images, etc.
  offers = offersData.map((offer: any) => ({
    ...offer,
    user: userData // inject user data so the card can display the author
  }));
}
---

<Layout>
  <div class="flex-1 flex flex-col p-6 max-w-7xl mx-auto w-full">
    <div class="mb-10 mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold text-white tracking-tight">My Offers</h1>
        <p class="text-zinc-400 mt-2 text-lg">Manage your listings in the community directory.</p>
      </div>
      <a href="/offers/new" class="inline-flex items-center justify-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-medium transition-colors w-full sm:w-auto">
        Create New Offer
      </a>
    </div>

    {offersError && (
      <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 mb-8">
        Failed to load your offers: {(offersError as any).message || JSON.stringify(offersError)}
      </div>
    )}

    {offers.length === 0 && !offersError ? (
      <div class="flex flex-col items-center justify-center p-12 bg-zinc-900/50 rounded-2xl text-center border border-zinc-800">
        <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-4 text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <h3 class="text-xl font-medium text-white mb-2">You haven't created any offers yet</h3>
        <p class="text-zinc-400 mb-6 max-w-md">Share your skills, services, or products with the community to start matching with others.</p>
        <a href="/offers/new" class="px-6 py-3 bg-white text-zinc-950 hover:bg-zinc-200 rounded-xl font-medium transition-colors">
          Create Your First Offer
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-6 gap-y-10">
        {offers.map((offer: any) => (
          <div class="relative group">
            <OfferCard offer={offer} />
            <a href={`/offers/${offer.id}/edit`} class="absolute top-3 right-3 p-2 bg-zinc-950/80 backdrop-blur-md hover:bg-brand-500 rounded-lg text-white opacity-0 group-hover:opacity-100 transition-all border border-white/10 z-10">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </a>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
